<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest ExtensionBundleId="io.ynput.FLA.panel" ExtensionBundleVersion="1.0.03" Version="7.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<ExtensionList>
		<Extension Id="io.ynput.FLA.panel" Version="1.0.0" />
	</ExtensionList>
	<ExecutionEnvironment>
		<HostList>
			<Host Name="FLPR" Version="20.0" />
		</HostList>
		<LocaleList>
			<Locale Code="All" />
		</LocaleList>
		<RequiredRuntimeList>
			<RequiredRuntime Name="CSXS" Version="9.0" />
		</RequiredRuntimeList>
	</ExecutionEnvironment>
	<DispatchInfoList>
		<Extension Id="io.ynput.FLA.panel">
			<DispatchInfo>
				<Resources>
				 <MainPath>./index.html</MainPath>
				 <CEFCommandLine>
				 	<Parameter>--enable-nodejs</Parameter>
					<Parameter>--mixed-context</Parameter>

				 </CEFCommandLine>
				</Resources>
				<Lifecycle>
					<AutoVisible>true</AutoVisible>
                    <StartOn>
                    <Event>applicationActivate</Event>
                    <Event>com.adobe.csxs.events.ApplicationInitialized</Event>
                    <Event>documentAfterOpen</Event>
                    <Event>documentAfterActivate</Event>
          </StartOn>
				</Lifecycle>
				<UI>
					<Type>Panel</Type>
                    <Menu>AYON</Menu>
					<Geometry>
            <Size>
              <Width>300</Width>
              <Height>140</Height>
            </Size>
            <MaxSize>
              <Width>400</Width>
              <Height>200</Height>
            </MaxSize>
          </Geometry>
				</UI>
			</DispatchInfo>
		</Extension>
	</DispatchInfoList>
</ExtensionManifest>